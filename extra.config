# 覆盖 Kwrt 默认，对齐这套固件：x86_64 generic、EFI、ext4。
# 启动分区 16MiB，根分区 1004MiB，与已经编好的镜像一致。
# 现机根分区是 1024MiB，第一次 sysupgrade 会整盘重写一次。
# 写完后磁盘变成 1004，以后的镜像不要改这个数。
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TESTING_KERNEL is not set

CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_VMDK_IMAGES=n

CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=1004
CONFIG_TARGET_ROOTFS_TARGZ=y

# 家用编译不需要 ImageBuilder，省磁盘和时间
# CONFIG_IB is not set
# CONFIG_IB_STANDALONE is not set

CONFIG_VERSION_DIST="Ryan-OpenWrt"
CONFIG_VERSION_PRODUCT="Generic"
# VERSION_HOME_URL / MANUFACTURER 由 scripts/build-options.sh 按选项写入

# 与现机一致：用 ip-full，不要 ip-tiny
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_ip-tiny is not set

# 不要编全量用户态包，否则 kiddin9 里编不过的包也会进 world。
# CONFIG_ALL is not set

# OpenWrt 25.12 官方包名是 snmpd-nossl（PROVIDES snmpd）。
CONFIG_PACKAGE_snmpd-nossl=y
# CONFIG_PACKAGE_snmpd-ssl is not set
# CONFIG_PACKAGE_libnetsnmp-ssl is not set
# CONFIG_PACKAGE_snmp-utils-ssl is not set
# CONFIG_PACKAGE_snmp-mibs-ssl is not set
# CONFIG_PACKAGE_snmptrapd-ssl is not set
# CONFIG_PACKAGE_snmpd-static-ssl is not set
# CONFIG_PACKAGE_luci-app-snmpd-ssl is not set

# 加速编译：Kwrt 通用配置默认把源里所有包/内核模块都编成 =m，
# 还会生成 ImageBuilder。这些都不进固件、也不发布，关掉只编固件里的东西。
# CONFIG_ALL_NONSHARED is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL is not set
# CONFIG_IB is not set
# CONFIG_IB_STANDALONE is not set
# CONFIG_SDK is not set
# CONFIG_MAKE_TOOLCHAIN is not set
CONFIG_CCACHE=y
# Go 编译缓存目录。留空则是 $(TMP_DIR)/go-build，prepare.sh 会 rm -rf tmp，也无法跨 CI 任务复用。
CONFIG_GOLANG_BUILD_CACHE_DIR="$(TOPDIR)/.go-cache"
