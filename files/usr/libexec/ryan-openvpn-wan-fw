#!/bin/sh
# 只管理 firewall.openvpn（WAN 上放行 OpenVPN 服务端监听端口）。
# luci-app-openvpn-server-client 保存时会执行：
#   uci set firewall.openvpn.dest_port=$(uci get openvpn.myvpn.port)
# 所以必须沿用这一段名，用 enabled 开关，不能改名或删掉段。
# 客户端实例只是出站连接，不要为此打开 WAN 端口。

RULE=openvpn
LOG=ryan-openvpn-wan-fw

is_on() {
	case "$1" in
		1|on|true|yes) return 0 ;;
		*) return 1 ;;
	esac
}

section_enabled() {
	is_on "$(uci -q get "openvpn.$1.enabled")" && return 0
	is_on "$(uci -q get "openvpn.$1.enable")"
}

is_server_section() {
	case "$1" in
		"") return 1 ;;
		myvpn|myvpn_*) return 0 ;;
	esac
	[ -n "$(uci -q get "openvpn.$1.server")" ]
}

list_sections() {
	uci -q show openvpn 2>/dev/null | sed -n "s/^openvpn\.\([^=]*\)=openvpn$/\1/p"
}

enabled_server_ports() {
	PORTS=
	for s in $(list_sections); do
		is_server_section "$s" || continue
		section_enabled "$s" || continue
		p="$(uci -q get "openvpn.$s.port")"
		[ -n "$p" ] || p=1194
		case " $PORTS " in
			*" $p "*) ;;
			*) PORTS="${PORTS:+$PORTS }$p" ;;
		esac
	done
}

other_server_running() {
	skip="$1"
	for s in $(list_sections); do
		[ "$s" = "$skip" ] && continue
		is_server_section "$s" || continue
		[ -e "/var/run/openvpn.$s.status" ] || continue
		return 0
	done
	return 1
}

rule_is_ours() {
	# 段不存在：可以创建。
	# 段存在但不是 rule，或 src 已设且不是 wan：不改，避免动到无关规则。
	if ! uci -q get "firewall.$RULE" >/dev/null; then
		return 0
	fi
	typ="$(uci -q get "firewall.$RULE")"
	[ "$typ" = rule ] || return 1
	src="$(uci -q get "firewall.$RULE.src")"
	[ -z "$src" ] || [ "$src" = wan ] || return 1
	return 0
}

ensure_rule() {
	rule_is_ours || {
		logger -t "$LOG" "firewall.$RULE exists but is not the WAN OpenVPN accept rule, skip"
		return 1
	}
	# 新建时直接 commit：之后 apply_rule 若判定无变化不会再 commit，规则不能只停在 /tmp/.uci 里。
	if ! uci -q get "firewall.$RULE" >/dev/null; then
		uci -q batch <<-EOF
			set firewall.$RULE=rule
			set firewall.$RULE.name='openvpn'
			set firewall.$RULE.target='ACCEPT'
			set firewall.$RULE.src='wan'
			set firewall.$RULE.proto='tcp udp'
			set firewall.$RULE.dest_port='1194'
			set firewall.$RULE.enabled='0'
			commit firewall
		EOF
	fi
	return 0
}

fw_reload() {
	if [ -x /etc/init.d/firewall ]; then
		/etc/init.d/firewall reload >/dev/null 2>&1 || /etc/init.d/firewall restart >/dev/null 2>&1 || true
	fi
}

apply_rule() {
	# $1 = 1 或 0；$2 = 端口（启用时需要）
	want_en="$1"
	want_port="$2"
	ensure_rule || return 0
	cur_en="$(uci -q get "firewall.$RULE.enabled")"
	[ -n "$cur_en" ] || cur_en=1
	cur_port="$(uci -q get "firewall.$RULE.dest_port")"
	changed=0
	if [ "$want_en" = 1 ]; then
		[ "$cur_en" = 1 ] || { uci set "firewall.$RULE.enabled=1"; changed=1; }
		if [ -n "$want_port" ] && [ "$cur_port" != "$want_port" ]; then
			uci set "firewall.$RULE.dest_port=$want_port"
			changed=1
		fi
		[ "$(uci -q get "firewall.$RULE.src")" = wan ] || { uci set "firewall.$RULE.src=wan"; changed=1; }
		[ "$(uci -q get "firewall.$RULE.target")" = ACCEPT ] || { uci set "firewall.$RULE.target=ACCEPT"; changed=1; }
		proto="$(uci -q get "firewall.$RULE.proto")"
		[ -n "$proto" ] || { uci set "firewall.$RULE.proto=tcp udp"; changed=1; }
	else
		[ "$cur_en" = 0 ] || { uci set "firewall.$RULE.enabled=0"; changed=1; }
	fi
	[ "$changed" = 1 ] || return 0
	uci commit firewall
	fw_reload
}

cmd="${1:-sync}"
inst="${2:-}"

case "$cmd" in
	up)
		if [ -n "$inst" ] && ! is_server_section "$inst"; then
			exit 0
		fi
		enabled_server_ports
		if [ -n "$inst" ]; then
			p="$(uci -q get "openvpn.$inst.port")"
			[ -n "$p" ] || p=1194
			case " $PORTS " in
				*" $p "*) ;;
				*) PORTS="${PORTS:+$PORTS }$p" ;;
			esac
		fi
		[ -n "$PORTS" ] || PORTS=1194
		apply_rule 1 "$PORTS"
		;;
	down)
		if [ -n "$inst" ] && ! is_server_section "$inst"; then
			exit 0
		fi
		if other_server_running "$inst"; then
			enabled_server_ports
			[ -n "$PORTS" ] && apply_rule 1 "$PORTS"
			exit 0
		fi
		apply_rule 0
		;;
	sync)
		enabled_server_ports
		if [ -n "$PORTS" ]; then
			apply_rule 1 "$PORTS"
		else
			apply_rule 0
		fi
		;;
	*)
		echo "usage: $0 sync|up [instance]|down [instance]" >&2
		exit 1
		;;
esac
exit 0
