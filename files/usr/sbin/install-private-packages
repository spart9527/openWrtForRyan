#!/bin/sh
# 读取路由本地清单，逐个补装还没装上的包。清单不要放进 GitHub。
# 退出码：0 = 清单里的包都已装上；1 = 仍有包没装上（下次 WAN 拨号再试）。

LIST="${PRIVATE_PACKAGES:-/root/private-packages.txt}"

if [ ! -f "$LIST" ]; then
	echo "missing $LIST"
	exit 1
fi

pkgs="$(grep -vE '^[[:space:]]*(#|$)' "$LIST" | tr -d '\r' | tr '\n' ' ')"
[ -n "$pkgs" ] || { echo "empty package list"; exit 0; }

if command -v apk >/dev/null 2>&1; then
	installed() { apk info -e "$1" >/dev/null 2>&1; }
	refresh() { apk update || echo "apk update reported errors, continuing"; }
	add() { apk add "$1"; }
else
	installed() { opkg status "$1" 2>/dev/null | grep -q '^Status:.* installed'; }
	# 某个源 404 时 opkg update 会返回非 0，但其它源已更新，不要因此中止
	refresh() { opkg update || echo "opkg update reported errors, continuing"; }
	add() { opkg install "$1"; }
fi

todo=""
for p in $pkgs; do
	installed "$p" || todo="$todo $p"
done
[ -n "$todo" ] || { echo "all private packages installed"; exit 0; }
refresh

failed=""
for p in $todo; do
	echo "==> install $p"
	# 逐个装：某个包下架（比如这次的 wireguard）不影响其它包
	add "$p" || true
	installed "$p" || failed="$failed $p"
done

if [ -n "$failed" ]; then
	echo "still missing:$failed"
	exit 1
fi
echo "all private packages installed"
exit 0
