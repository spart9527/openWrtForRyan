#!/bin/sh /etc/rc.common
# 新固件启动后，按 /root/private-packages.txt 补装缺的包。
# 开机跑一次；之后每次 WAN 拨号成功（hotplug）再试，直到清单里的包都装上。
# 不用"版本号 stamp"判断：Kwrt 的版本号只到日期，同一天编两次会被误判成已装过。

START=99

LIST=/root/private-packages.txt
LOG=/tmp/private-packages.log
LOCK=/tmp/private-packages.lock
DNS_MARK=/etc/private-packages.dns-restored

# 旧配置里 dnsmasq port=0（交给 SmartDNS/PassWall 接管 53）被保留下来，
# 但新固件里这些包还没装时，全家 DNS 都会断，opkg 也下不了包。
# 临时让 dnsmasq 接管 53，并做标记，装好后再还原。
dns_guard() {
	port="$(uci -q get dhcp.@dnsmasq[0].port)"
	[ "$port" = "0" ] || return 0
	[ -x /etc/init.d/smartdns ] && return 0
	[ -x /etc/init.d/passwall ] && return 0
	logger -t private-packages "dnsmasq port=0 but no smartdns/passwall, temporarily restore port 53"
	uci -q delete dhcp.@dnsmasq[0].port
	uci commit dhcp
	touch "$DNS_MARK"
	/etc/init.d/dnsmasq restart
}

# 私有包装好后，把 dnsmasq 还给 SmartDNS/PassWall（和升级前一致）
dns_restore() {
	[ -f "$DNS_MARK" ] || return 0
	[ -x /etc/init.d/smartdns ] || [ -x /etc/init.d/passwall ] || return 0
	logger -t private-packages "private packages ready, set dnsmasq port=0 back"
	uci set dhcp.@dnsmasq[0].port='0'
	uci commit dhcp
	rm -f "$DNS_MARK"
	/etc/init.d/dnsmasq restart
	[ -x /etc/init.d/smartdns ] && /etc/init.d/smartdns restart
	[ -x /etc/init.d/passwall ] && /etc/init.d/passwall restart
}

wait_net() {
	n=0
	while [ "$n" -lt 60 ]; do
		ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1 && return 0
		n=$((n + 1))
		sleep 5
	done
	return 1
}

run_install() {
	dns_guard

	if [ ! -f "$LIST" ]; then
		logger -t private-packages "missing $LIST, nothing to install"
		return 0
	fi
	[ -x /usr/sbin/install-private-packages ] || return 0

	mkdir "$LOCK" 2>/dev/null || return 0
	trap 'rmdir "$LOCK" 2>/dev/null' EXIT

	logger -t private-packages "waiting for network"
	if ! wait_net; then
		logger -t private-packages "network timeout, will retry on next wan up"
		return 1
	fi

	if /usr/sbin/install-private-packages >"$LOG" 2>&1; then
		logger -t private-packages "all installed"
		dns_restore
		return 0
	fi

	logger -t private-packages "$(tail -n 1 "$LOG"), see $LOG; will retry on next wan up"
	return 1
}

boot() {
	run_install &
}

start() {
	run_install
}
