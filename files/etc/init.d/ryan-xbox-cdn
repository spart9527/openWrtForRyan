#!/bin/sh /etc/rc.common
# 把 Xbox CDN 的 address/SRV/filter-AAAA 写入 PassWall 在 11400 上的临时 dnsmasq。
# PassWall 会把多数 53 端口查询（含本机 lo）重定向到这份配置；它一重启就会按模板重写，
# 所以开机等待配置出现后写入，并用 cron 在之后再补。不能只给进程发 HUP，必须重新拉起。
# 没有 PassWall 或配置尚未生成时安静退出。不要执行 /etc/init.d/passwall restart。

START=99
STOP=15

CONF=/tmp/etc/passwall/acl/default/dnsmasq.conf
BIN=/tmp/etc/passwall/bin/dnsmasq_default
PIDFILE=/tmp/etc/passwall/acl/default/dnsmasq.pid
HOSTS="assets1.xboxlive.com assets2.xboxlive.com d1.xboxlive.com d2.xboxlive.com xvcf1.xboxlive.com xvcf2.xboxlive.com dlassets.xboxlive.com dlassets2.xboxlive.com 5.xb.delivery.microsoft.com assets1.xboxlive.com.edgesuite.net cl-glcb907925.gcdn.co fg.microsoft.map.fastly.net"
SRV='srv-host=assets-srvs-net.trafficmanager.net,assets1.xboxlive.com,80,0,1000'

lan_ip() {
	LAN_IP=192.168.1.1
	[ -f /etc/ryan-build.conf ] && . /etc/ryan-build.conf
	LAN_IP="${LAN_IP:-192.168.1.1}"
}

esc_host() {
	printf '%s' "$1" | sed 's/\./\\./g'
}

ready() {
	[ -f "$CONF" ] && [ -x "$BIN" ]
}

rules_ok() {
	local h
	lan_ip
	[ -f "$CONF" ] || return 1
	for h in $HOSTS; do
		grep -qF "address=/$h/$LAN_IP" "$CONF" || return 1
	done
	grep -qF "$SRV" "$CONF" || return 1
	grep -qx 'filter-AAAA' "$CONF" || return 1
	return 0
}

apply_rules() {
	local h escaped changed=0
	lan_ip
	for h in $HOSTS; do
		if ! grep -qF "address=/$h/$LAN_IP" "$CONF"; then
			escaped=$(esc_host "$h")
			sed -i "/^address=\/${escaped}\//d" "$CONF"
			printf 'address=/%s/%s\n' "$h" "$LAN_IP" >> "$CONF"
			changed=1
		fi
	done
	if ! grep -qF "$SRV" "$CONF"; then
		printf '%s\n' "$SRV" >> "$CONF"
		changed=1
	fi
	if ! grep -qx 'filter-AAAA' "$CONF"; then
		printf 'filter-AAAA\n' >> "$CONF"
		changed=1
	fi
	[ "$changed" = 1 ]
}

restart_default() {
	pids=$(pidof dnsmasq_default) && kill $pids 2>/dev/null
	sleep 1
	# 若 PassWall 的守护进程已按原命令拉起（会读到刚写入的配置），就不必再启一份
	pidof dnsmasq_default >/dev/null && return 0
	[ -x "$BIN" ] && [ -f "$CONF" ] || return 1
	"$BIN" -k -C "$CONF" -x "$PIDFILE" >/dev/null 2>&1 &
}

do_apply() {
	# PassWall 未安装或尚未写出临时配置时不做事
	[ -x /etc/init.d/passwall ] || [ -x "$BIN" ] || return 0
	ready || return 0
	if rules_ok && pidof dnsmasq_default >/dev/null; then
		return 0
	fi
	apply_rules || true
	rules_ok || return 1
	# 规则已在文件里但进程还是旧的（或未运行）：必须重新拉起，HUP 不会重读主配置
	restart_default
}

start() {
	do_apply
}

boot() {
	local i=0
	# PassWall 的 boot 在后台、还可能有启动延时，等临时配置出现再写
	while ! ready; do
		i=$((i + 1))
		[ "$i" -ge 90 ] && return 0
		sleep 1
	done
	do_apply
}

stop() {
	return 0
}
